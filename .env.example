# Amrutam Telemedicine Backend - Environment Variables Template
# Copy this file to '.env' for local development:
# cp .env.example .env
# WARNING: Never commit the actual '.env' file or production secrets to source control.

# Application Settings
APP_NAME="Amrutam Telemedicine API"
APP_ENV="development" # development | staging | production | test
DEBUG=false
API_V1_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000

# Logging & Observability
LOG_LEVEL="INFO" # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT="console" # console | json
METRICS_ENABLED=true
METRICS_AUTH_TOKEN="" # Optional bearer token/header required for /metrics in production
TRACING_ENABLED=true

# Security & Cryptography
# Generate a secure key in production: openssl rand -hex 32
SECRET_KEY="insecure-development-secret-key-replace-in-production-min-32-chars"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# Base64-encoded 32-byte key for AES-256 MFA secret encryption: openssl rand -base64 32
MFA_ENCRYPTION_KEY="insecure-dev-mfa-key-32-bytes-base64="

# Database (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/amrutam_telemedicine"
TEST_DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/amrutam_telemedicine_test"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
AUTO_MIGRATE=false # Run alembic migrations automatically on startup
SEED_DEMO_DATA=false # Automatically seed demo accounts (Doctor, Patient, Admin) on startup

# PostgreSQL Container (Docker Compose)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="amrutam_telemedicine"
POSTGRES_PORT=5432

# Redis / Cache (Optional)
REDIS_URL="redis://localhost:6379/0"

# Rate Limiting & Resilience Policies
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND="memory" # memory | redis
RATE_LIMIT_REDIS_URL="redis://localhost:6379/0"
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_MFA_REQUESTS=10
RATE_LIMIT_MFA_WINDOW_SECONDS=60
RATE_LIMIT_WRITE_REQUESTS=30
RATE_LIMIT_WRITE_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_REQUESTS=120
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60

# Request Body & Pagination Limits
MAX_REQUEST_BODY_BYTES=1048576 # 1 MB
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# External HTTP Timeouts (Seconds)
EXTERNAL_HTTP_CONNECT_TIMEOUT_SECONDS=3.0
EXTERNAL_HTTP_READ_TIMEOUT_SECONDS=5.0
EXTERNAL_HTTP_WRITE_TIMEOUT_SECONDS=5.0
EXTERNAL_HTTP_POOL_TIMEOUT_SECONDS=3.0

# Database Deadlock Retries
DB_DEADLOCK_MAX_RETRIES=3
DB_DEADLOCK_BASE_DELAY=0.05
DB_DEADLOCK_MAX_DELAY=0.5

# Idempotency Key Configuration
IDEMPOTENCY_DEFAULT_TTL_SECONDS=86400
IDEMPOTENCY_IN_PROGRESS_TIMEOUT_SECONDS=120

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

